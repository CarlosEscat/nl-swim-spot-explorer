# Supabase — create a project at https://supabase.com, then run supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — used ONLY by ingestion scripts and cron routes (server-side). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for Vercel Cron routes (set the same value in Vercel project env vars)
CRON_SECRET=

# MapTiler API key for the explorer map's vector tiles — https://cloud.maptiler.com/account/keys
NEXT_PUBLIC_MAPTILER_KEY=

# When Supabase vars are unset, the app and scripts read/write local JSON under data/local/ instead.
